# Database
DATABASE_URL=postgresql://user:password@localhost:5432/taximetro

# Auth
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_URL=https://mnrs.com.br

# Telegram
# Use TELEGRAM_BOT_TOKEN_NEXT during token rotation. App prefers NEXT over legacy token.
TELEGRAM_BOT_TOKEN_NEXT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Link de cadastro exibido na dica pós-validação ("off" suprime a dica). Vazio = link do cliente original.
TELEGRAM_PRECEPTOR_REGISTRATION_URL=
# Chat privado que recebe o backup diário (dump + relatórios em PDF) e alertas de falha.
TELEGRAM_ADMIN_CHAT_ID=
# Link do grupo de validação usado no QR do check-in (build-time). Vazio = grupo do cliente original.
NEXT_PUBLIC_TELEGRAM_GROUP_LINK=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Taximetro Digital <noreply@mnrs.com.br>

# Runtime
PORT=3000
TZ=America/Bahia

# Daily DB backup cron
DB_BACKUP_ENABLED=true
DB_BACKUP_CRON=37 3 * * *
DB_BACKUP_TZ=America/Bahia
DB_BACKUP_DIR=/var/backups/taximetro
DB_BACKUP_PREFIX=taximetro
DB_BACKUP_RETENTION_DAYS=14
DB_BACKUP_EMAIL_TO=
DB_BACKUP_S3_ENABLED=false
DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_REGION=us-east-1
DB_BACKUP_S3_PREFIX=taximetro/backups
DB_BACKUP_S3_ENDPOINT=
DB_BACKUP_S3_FORCE_PATH_STYLE=false

# Telegram pending-checkin reminder cron
TELEGRAM_CHECKIN_REMINDER_ENABLED=true
TELEGRAM_CHECKIN_REMINDER_CRON=0 8,9 * * *
