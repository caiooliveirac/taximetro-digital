# ─────────────────────────────────────────────────────────────────
# Este arquivo é o molde. Em desenvolvimento, cada instância tem o SEU
# arquivo, e o nome importa — os comandos de banco recusam rodar se o
# DATABASE_URL não bater com a instância pedida (ver scripts/db-run.mjs):
#
#   .env.samu.local      → banco precisa conter "taximetro"
#   .env.vitalmed.local  → banco precisa conter "vitalmed"
#
# O ".env.local" genérico foi aposentado: servia para as duas instâncias e
# era o caminho mais curto para um "db:reset" acertar o banco errado.
# ─────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/taximetro

# Instância: samu (padrão, pode omitir) ou vitalmed.
# Chave única que decide branding, menus e quais funcionalidades existem.
# É build arg do Docker, não runtime — ver src/lib/instance.ts.
NEXT_PUBLIC_ORG=

# Override do link do grupo Telegram do check-in. Vazio = padrão da instância.
NEXT_PUBLIC_TELEGRAM_GROUP_LINK=

# Auth
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_URL=https://mnrs.com.br

# Telegram
# Use TELEGRAM_BOT_TOKEN_NEXT during token rotation. App prefers NEXT over legacy token.
TELEGRAM_BOT_TOKEN_NEXT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Taximetro Digital <noreply@mnrs.com.br>

# Runtime
PORT=3000
TZ=America/Bahia

# Daily DB backup cron
DB_BACKUP_ENABLED=true
DB_BACKUP_CRON=37 3 * * *
DB_BACKUP_TZ=America/Bahia
DB_BACKUP_DIR=/var/backups/taximetro
DB_BACKUP_PREFIX=taximetro
DB_BACKUP_RETENTION_DAYS=14
DB_BACKUP_EMAIL_TO=
DB_BACKUP_S3_ENABLED=false
DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_REGION=us-east-1
DB_BACKUP_S3_PREFIX=taximetro/backups
DB_BACKUP_S3_ENDPOINT=
DB_BACKUP_S3_FORCE_PATH_STYLE=false

# Telegram pending-checkin reminder cron
TELEGRAM_CHECKIN_REMINDER_ENABLED=true
TELEGRAM_CHECKIN_REMINDER_CRON=0 8,9 * * *
