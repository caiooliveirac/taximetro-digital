{
  "name": "taximetro-digital",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:backup": "node scripts/daily-db-backup.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node --env-file .env.local node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file .env.local node_modules/.bin/drizzle-kit studio",
    "db:seed": "node --env-file .env.local --import tsx src/db/seed.ts",
    "db:seed-dev": "node --env-file .env.local --import tsx src/db/seed-dev.ts",
    "db:seed-cohorts": "node --env-file .env.local --import tsx src/db/seed-cohorts.ts",
    "db:seed-prod": "node --env-file .env.local --import tsx src/db/seed-prod.ts",
    "db:demo": "node --env-file .env.local --import tsx src/db/seed.ts && node --env-file .env.local --import tsx src/db/seed-dev.ts && node --env-file .env.local --import tsx src/db/seed-cohorts.ts",
    "db:clean": "node --env-file .env.local --import tsx src/db/clean-dev.ts",
    "db:reset": "node --env-file .env.local --import tsx src/db/clean-dev.ts && node --env-file .env.local --import tsx src/db/seed.ts && node --env-file .env.local --import tsx src/db/seed-dev.ts && node --env-file .env.local --import tsx src/db/seed-cohorts.ts",
    "test": "npx tsx --test tests/**/*.test.ts src/features/scheduling/__tests__/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "eslint-config-next": "16.2.6",
    "grammy": "^1.41.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  },
  "browserslist": [
    "chrome >= 110",
    "firefox >= 110",
    "edge >= 110",
    "safari >= 16.3",
    "ios_saf >= 16.3",
    "samsung >= 20",
    "opera >= 95",
    "and_chr >= 110"
  ]
}
