{
  "name": "taximetro-digital",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:backup": "node scripts/daily-db-backup.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node --env-file .env.local node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file .env.local node_modules/.bin/drizzle-kit studio",
    "db:seed": "node --env-file .env.local --import tsx src/db/seed.ts",
    "db:seed-dev": "node --env-file .env.local --import tsx src/db/seed-dev.ts",
    "db:seed-prod": "node --env-file .env.local --import tsx src/db/seed-prod.ts",
    "db:demo": "node --env-file .env.local --import tsx src/db/seed.ts && node --env-file .env.local --import tsx src/db/seed-dev.ts",
    "db:clean": "node --env-file .env.local --import tsx src/db/clean-dev.ts",
    "db:reset": "node --env-file .env.local --import tsx src/db/clean-dev.ts && node --env-file .env.local --import tsx src/db/seed.ts && node --env-file .env.local --import tsx src/db/seed-dev.ts",
    "test": "npx tsx --test tests/**/*.test.ts src/features/scheduling/__tests__/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "grammy": "^1.41.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.13",
    "next-auth": "5.0.0-beta.29",
    "nodemailer": "^6.10.1",
    "otplib": "^13.4.0",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
