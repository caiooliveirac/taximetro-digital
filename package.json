{
  "name": "taximetro-digital",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/db-run.mjs samu npx next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:backup": "node scripts/daily-db-backup.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db": "node scripts/db-run.mjs",
    "db:push": "node scripts/db-run.mjs samu node_modules/.bin/drizzle-kit push",
    "db:studio": "node scripts/db-run.mjs samu node_modules/.bin/drizzle-kit studio",
    "db:seed": "node scripts/db-run.mjs samu npx tsx src/db/seed.ts",
    "db:seed-dev": "node scripts/db-run.mjs samu npx tsx src/db/seed-dev.ts",
    "db:seed-cohorts": "node scripts/db-run.mjs samu npx tsx src/db/seed-cohorts.ts",
    "db:seed-prod": "node scripts/db-run.mjs samu npx tsx src/db/seed-prod.ts",
    "db:demo": "npm run db:seed && npm run db:seed-dev && npm run db:seed-cohorts",
    "db:clean": "node scripts/db-run.mjs samu npx tsx src/db/clean-dev.ts",
    "db:reset": "npm run db:clean && npm run db:demo",
    "db:push:vitalmed": "node scripts/db-run.mjs vitalmed node_modules/.bin/drizzle-kit push",
    "db:studio:vitalmed": "node scripts/db-run.mjs vitalmed node_modules/.bin/drizzle-kit studio",
    "db:seed:vitalmed": "node scripts/db-run.mjs vitalmed npx tsx src/db/seed-vitalmed.ts",
    "test": "npx tsx --test tests/**/*.test.ts src/features/scheduling/__tests__/*.test.ts",
    "dev:vitalmed": "node scripts/db-run.mjs vitalmed npx next dev -p 3001"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "eslint-config-next": "^16.3.2",
    "grammy": "^1.45.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^9.0.5",
    "otplib": "^13.5.0",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  },
  "browserslist": [
    "chrome >= 110",
    "firefox >= 110",
    "edge >= 110",
    "safari >= 16.3",
    "ios_saf >= 16.3",
    "samsung >= 20",
    "opera >= 95",
    "and_chr >= 110"
  ]
}
